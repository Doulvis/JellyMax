{
  "name": "jellymax",
  "productName": "JellyMax",
  "version": "1.1.1",
  "description": "Client Jellyfin pour Windows au design inspiré de HBO Max",
  "author": "JellyMax",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "build:tizen": "tsc --noEmit && vite build --mode tizen",
    "tizen:package": "npm run build:tizen && node scripts/tizen.mjs package",
    "tizen:install": "node scripts/tizen.mjs install",
    "build:android": "tsc --noEmit && vite build --mode android && cap sync android",
    "android:apk": "npm run build:android && node scripts/android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "@fontsource/inter": "5.1.0",
    "hls.js": "1.5.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "app.jellymax.desktop",
    "productName": "JellyMax",
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "JellyMax",
      "artifactName": "JellyMax-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "JellyMax-Portable-${version}.exe"
    }
  }
}
